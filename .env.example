# NVIDIA API key from https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-xxxxxxxx

# Models (defaults shown)
# LLM_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_REQUESTS_PER_MINUTE=36

# Supervisor approval for large returns
APPROVAL_ENABLED=false
APPROVAL_THRESHOLD=1000
