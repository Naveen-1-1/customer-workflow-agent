# NVIDIA API key from https://build.nvidia.com/settings/api-keys
NVIDIA_API_KEY=nvapi-xxxxxxxx

# Models (defaults shown)
# LLM_PRIMARY_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# LLM_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b
# LLM_REQUESTS_PER_MINUTE=36
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1   (any OpenAI-compatible endpoint)

# Tracing with LangSmith (https://smith.langchain.com/settings): off unless both are set
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_xxxxxxxx
# LANGSMITH_PROJECT=customer-workflow-agent

# Capacity: chats open at once; an idle chat frees its slot after this many minutes
# MAX_OPEN_CHATS=10
# CHAT_IDLE_MINUTES=10

# Supervisor approval for large returns
APPROVAL_ENABLED=false
APPROVAL_THRESHOLD=1000
